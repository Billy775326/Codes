{
  "name": "codes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted Linux workspace for Codex CLI",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx src/server/main.ts --dev",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "install:command": "node scripts/install-command.mjs",
    "demo": "CODES_RUNTIME=mock node dist/server/main.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:native": "node --import tsx scripts/native-smoke.ts",
    "test:live:ide": "node --import tsx scripts/live-ide-pilot.ts",
    "test:live": "node --import tsx scripts/live-pilot.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "image-size": "2.1.0",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
